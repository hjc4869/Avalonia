<Project Sdk="Microsoft.Build.NoTargets/3.7.134">

  <!--
    Generates inc/avalonia-native.h from avn.idl and builds the Xcode project producing shared and static libraries,
    which Avalonia.Native.csproj then copies and packs.

    This lives in a project of its own rather than in Avalonia.Native.csproj because the latter is multi-targeted:
    a target hosted there would run once per inner build, concurrently.
  -->

  <Import Project="../../build/AvaloniaNative.props" />

  <PropertyGroup>
    <!-- There is nothing to compile here: the target framework is only needed so that PackageReference can be restored. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>

    <UseMicroComGeneratorMSBuild>true</UseMicroComGeneratorMSBuild>
    <BuildAvaloniaNativeXcodeProject Condition="'$(BuildAvaloniaNativeXcodeProject)' == ''">$([MSBuild]::IsOSPlatform(OSX))</BuildAvaloniaNativeXcodeProject>
  </PropertyGroup>

  <ItemGroup>
    <MicroComIdl Include="$(AvaloniaNativeIdl)"
                 Link="avn.idl"
                 CppHeaderPath="$(AvaloniaNativeHeader)" />
  </ItemGroup>

  <!-- Build the underlying Xcode project whenever one of its sources changed -->
  <ItemGroup Condition="'$(BuildAvaloniaNativeXcodeProject)' == 'true'">
    <AvaloniaNativeSource Include="$(AvaloniaNativeSourceDir)/**/*.m;$(AvaloniaNativeSourceDir)/**/*.mm;$(AvaloniaNativeSourceDir)/**/*.cpp;$(AvaloniaNativeSourceDir)/**/*.h" />
    <AvaloniaNativeSource Include="$(AvaloniaNativeXcodeProject)/**/*"
                          Exclude="$(AvaloniaNativeXcodeProject)/build/**/*;$(AvaloniaNativeXcodeProject)/DerivedData/**/*;$(AvaloniaNativeXcodeProject)/**/xcuserdata/**/*" />
    <_AvaloniaNativeStaticArchitecture Include="x86_64" RuntimeIdentifier="osx-x64" />
    <_AvaloniaNativeStaticArchitecture Include="arm64" RuntimeIdentifier="osx-arm64" />
  </ItemGroup>

  <Target Name="_GenerateAvaloniaNativeDependencyCache"
          DependsOnTargets="GenerateMicroComItems"
          Condition="'$(BuildAvaloniaNativeXcodeProject)' == 'true'">
    <PropertyGroup>
      <_AvaloniaNativeInputsCacheFilePath>$(IntermediateOutputPath)/AvaloniaNative/Sources.Inputs.cache</_AvaloniaNativeInputsCacheFilePath>
    </PropertyGroup>

    <ItemGroup>
      <CustomAdditionalCompileAvaloniaNativeInputs Include="$(_AvaloniaNativeInputsCacheFilePath)" />
    </ItemGroup>

    <Hash ItemsToHash="@(AvaloniaNativeSource);$(MSBuildAllProjects)">
      <Output TaskParameter="HashResult" PropertyName="AvaloniaNativeDependencyHash" />
    </Hash>

    <MakeDir Directories="$(IntermediateOutputPath)/AvaloniaNative" />
    <WriteLinesToFile File="$(_AvaloniaNativeInputsCacheFilePath)"
                      Lines="$(AvaloniaNativeDependencyHash)"
                      WriteOnlyWhenDifferent="True"
                      Overwrite="True" />

    <ItemGroup>
      <FileWrites Include="$(_AvaloniaNativeInputsCacheFilePath)" />
      <UpToDateCheckInput Include="@(CustomAdditionalCompileAvaloniaNativeInputs)"/>
    </ItemGroup>
  </Target>

  <Target Name="CompileAvaloniaNativeXcodeProject"
          Condition="'$(BuildAvaloniaNativeXcodeProject)' == 'true'"
          DependsOnTargets="GenerateMicroComItems;_GenerateAvaloniaNativeDependencyCache"
          BeforeTargets="CoreBuild"
          Inputs="@(AvaloniaNativeSource);@(CustomAdditionalCompileAvaloniaNativeInputs)"
          Outputs="$(AvaloniaNativeDylibPath)">

    <Message Text="Building native library $([System.IO.Path]::GetFileName($(AvaloniaNativeDylibPath)))"
             Importance="high" />

    <!-- TODO: Don't ignore xcode warnings, fix them instead -->
    <Exec Command="xcodebuild -quiet -project &quot;$(AvaloniaNativeXcodeProject)&quot; -configuration $(Configuration) CONFIGURATION_BUILD_DIR=&quot;$(AvaloniaNativeBuildDir)&quot; GCC_WARN_INHIBIT_ALL_WARNINGS=YES ONLY_ACTIVE_ARCH=NO"
          ConsoleToMSBuild="true"
          IgnoreExitCode="false"
          IgnoreStandardErrorWarningFormat="false"
          StandardOutputImportance="low"
          StandardErrorImportance="high" />

    <!-- Make sure the dylib is newer than its inputs, so the incremental check above doesn't run xcodebuild again -->
    <Touch Files="$(AvaloniaNativeDylibPath)"
           Condition="Exists($(AvaloniaNativeDylibPath))" />

  </Target>

  <Target Name="CompileAvaloniaNativeStaticLibraries"
          Condition="'$(BuildAvaloniaNativeXcodeProject)' == 'true'"
          DependsOnTargets="CompileAvaloniaNativeXcodeProject"
          BeforeTargets="CoreBuild"
          Inputs="@(AvaloniaNativeSource);@(CustomAdditionalCompileAvaloniaNativeInputs)"
          Outputs="$(AvaloniaNativeStaticDir)/%(_AvaloniaNativeStaticArchitecture.RuntimeIdentifier)/libAvaloniaNative.a;$(AvaloniaNativeStaticDir)/%(_AvaloniaNativeStaticArchitecture.RuntimeIdentifier)/macos_font_preinit.o">
    <PropertyGroup>
      <_AvaloniaNativeStaticBuildDir>$(AvaloniaNativeStaticDir)/%(_AvaloniaNativeStaticArchitecture.RuntimeIdentifier)</_AvaloniaNativeStaticBuildDir>
    </PropertyGroup>

    <Message Text="Building static native library for %(_AvaloniaNativeStaticArchitecture.RuntimeIdentifier)"
             Importance="high" />
    <MakeDir Directories="$(_AvaloniaNativeStaticBuildDir)" />
    <Exec Command="xcodebuild -quiet -project &quot;$(AvaloniaNativeXcodeProject)&quot; -target Avalonia.Native.OSX -configuration $(Configuration) -sdk macosx -arch %(_AvaloniaNativeStaticArchitecture.Identity) CONFIGURATION_BUILD_DIR=&quot;$(_AvaloniaNativeStaticBuildDir)&quot; OBJROOT=&quot;$(_AvaloniaNativeStaticBuildDir)/obj&quot; ONLY_ACTIVE_ARCH=NO CODE_SIGNING_ALLOWED=NO MACH_O_TYPE=staticlib EXECUTABLE_PREFIX=lib EXECUTABLE_EXTENSION=a PRODUCT_NAME=AvaloniaNative HEADER_SEARCH_PATHS=&quot;$(AvaloniaNativeSourceDir)/inc&quot; MACOSX_DEPLOYMENT_TARGET=11.0 CLANG_ENABLE_MODULES=YES GCC_GENERATE_DEBUGGING_SYMBOLS=NO GCC_WARN_INHIBIT_ALL_WARNINGS=YES"
          StandardOutputImportance="low"
          StandardErrorImportance="high" />
    <Exec Command="xcrun --sdk macosx clang -arch %(_AvaloniaNativeStaticArchitecture.Identity) -mmacosx-version-min=11.0 -fobjc-arc -c &quot;$(AvaloniaNativeSourceDir)/src/OSX/macos_font_preinit.m&quot; -o &quot;$(_AvaloniaNativeStaticBuildDir)/macos_font_preinit.o&quot;" />
    <Touch Files="$(_AvaloniaNativeStaticBuildDir)/libAvaloniaNative.a;$(_AvaloniaNativeStaticBuildDir)/macos_font_preinit.o" />
  </Target>

  <Target Name="CleanAvaloniaNativeOutput"
          Condition="'$(BuildAvaloniaNativeXcodeProject)' == 'true'"
          BeforeTargets="CoreClean">
    <Delete Files="$(AvaloniaNativeDylibPath)" />
    <RemoveDir Directories="$(AvaloniaNativeStaticDir)" />
  </Target>

  <Import Project="../../build/MicroCOM.props" />
</Project>
